# X (Twitter) API — 用户上下文 OAuth 1.0a
# 打开 https://console.x.com → 你的 App → Keys and tokens
# 四项必须对号入座，填反会出现 HTTP 401，侧栏却仍显示「已配置」。

# Consumer Keys（应用密钥，不是用户令牌）
# X_API_KEY = API Key / Consumer Key（短字符串，没有「数字ID-」前缀）
# X_API_SECRET = API Key Secret / Consumer Secret
X_API_KEY=
X_API_SECRET=

# User Tokens（用户访问令牌；Access Token 形如 1234567890-xxxxxxxx）
# 不要把这一项填进上面的 X_API_KEY。
# 删除推文需要权限为 Read and write；改权限后必须重新生成 Token 再粘贴到这里。
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 可选。Bearer Token 是 App-only，本工具拉自己的时间线 / 删除不用它。
X_BEARER_TOKEN=

# 本地日志（可选；缺省见 docs/LOGGING.md）
# XMANAGER_LOG_DIR=logs
# XMANAGER_LOG_LEVEL=info
# XMANAGER_LOG_APP_RETENTION_DAYS=14
# XMANAGER_LOG_AUDIT_RETENTION_DAYS=90
