# X (Twitter) API — User context OAuth 1.0a
# 在 https://developer.x.com 或 https://console.x.com 创建 App 后填写
# 删除推文需要 Access Token 权限为 Read and Write

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 可选（本工具主要使用 OAuth1 用户上下文）
X_BEARER_TOKEN=

# 本地日志（可选；缺省见 docs/LOGGING.md）
# XMANAGER_LOG_DIR=logs
# XMANAGER_LOG_LEVEL=info
# XMANAGER_LOG_APP_RETENTION_DAYS=14
# XMANAGER_LOG_AUDIT_RETENTION_DAYS=90
